# ─────────────────────────────────────────────────────────────────────────────
# Configurações do Firebase
# Copie este arquivo como .env.local e preencha com os valores do seu projeto.
#
# Para obter esses valores:
#   1. Acesse https://console.firebase.google.com
#   2. Selecione seu projeto → Configurações do Projeto → Seus aplicativos
#   3. Copie o objeto firebaseConfig
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# (Opcional) Measurement ID do Google Analytics — deixe vazio se não usar
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Senha de sistema (Ferramentas de Sistema / Importação em Lote)
# SEM prefixo NEXT_PUBLIC_ de propósito — fica só no servidor, nunca vai pro
# bundle do navegador. Escolha um valor só seu e configure também na Vercel
# (Project Settings → Environment Variables) pros ambientes Preview/Production.
# ─────────────────────────────────────────────────────────────────────────────
SYSTEM_TOOLS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Service account do Firebase. Usada por dois scripts, com regras diferentes:
#
#   scripts/seed-staging.ts (escreve dado) — SÓ roda se o project_id da chave
#     contiver "staging" e bater com NEXT_PUBLIC_FIREBASE_PROJECT_ID acima.
#     Nunca aponte isso pra uma chave de produção.
#
#   scripts/audit-ribbon-prices.ts (SOMENTE LEITURA, #65) — roda contra
#     qualquer projeto, tipicamente produção (a auditoria existe pra achar
#     dado ruim que já está lá). Sem guard de "staging" porque não há risco
#     de escrita; o project_id conectado é sempre impresso no relatório.
#
# Aponta pro ARQUIVO .json da chave, não pro conteúdo direto.
#
# Como gerar:
#   1. https://console.firebase.google.com → selecione o projeto (staging
#      pra seed, produção pra auditoria)
#   2. Configurações do Projeto → Contas de serviço → Gerar nova chave privada
#   3. Salve o .json baixado FORA do repo (ou numa pasta já coberta pelo
#      .gitignore, ex: qualquer *serviceAccountKey*.json/*firebase-adminsdk*.json)
#   4. Aponte o caminho absoluto/relativo aqui (troque antes de rodar cada
#      script, se as chaves forem de projetos diferentes)
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# Sentry — monitoramento de erros em produção (#82)
#
# NEXT_PUBLIC_SENTRY_DSN: opcional. Sem ela, a inicialização do Sentry é
#   um no-op silencioso (ver src/instrumentation.ts e
#   src/instrumentation-client.ts) — o app funciona normalmente sem
#   error tracking. Não é segredo (vai pro bundle do navegador por causa
#   do prefixo NEXT_PUBLIC_), mas o valor REAL de produção/preview deve
#   ser configurado no dashboard da Vercel (Project Settings →
#   Environment Variables), não commitado aqui.
#
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN: só usadas em build
#   time pra upload de source maps (next.config.ts → withSentryConfig).
#   SENTRY_AUTH_TOKEN É segredo — nunca commitar um valor real. Sem elas
#   o build funciona normalmente, só pula o upload de source map (stack
#   trace no Sentry fica minificado).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
